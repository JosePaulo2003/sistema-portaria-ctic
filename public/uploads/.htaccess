# GUIA DE MANUTENCAO: Protege este diretorio ou direciona requisicoes ao ponto de entrada.
# Ponto de atencao: uma regra permissiva aqui ignora toda a elegancia do PHP e entrega o arquivo mesmo assim.

Options -Indexes

<FilesMatch "\.(php|phtml|phar|cgi|pl|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
