# GUIA DE MANUTENCAO: Modelo sem segredos para configurar uma nova instalacao.
# Ponto de atencao: valor real aqui deixa de ser segredo assim que o Git percebe; e o Git percebe tudo.

APP_NAME=SGRP
APP_ENV=production
APP_DEBUG=false
APP_BASE_PATH=
APP_URL=http://sgrp

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sgrp
DB_USERNAME=sgrp_user
DB_PASSWORD=troque_esta_senha

FORM_WEBHOOK_TOKEN=troque_este_token

# Envio transacional e recuperação de senha
MAIL_HOST=smtp.exemplo.br
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=conta@exemplo.br
MAIL_PASSWORD=troque_por_uma_senha_de_aplicativo
MAIL_FROM_ADDRESS=conta@exemplo.br
MAIL_FROM_NAME="SGRP - CTIC/CESIT"
MAIL_TIMEOUT=15
